# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string (e.g. from Neon, Supabase or Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/truescholars"

# Auth.js — generate a secret with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
# Required when hosted behind a proxy (Render, Hostinger): lets Auth.js trust the host header
AUTH_TRUST_HOST="true"

# Comma-separated emails that get the ADMIN role (review experts, resolve disputes)
ADMIN_EMAILS=""

# Google sign-in (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Paystack — use TEST keys (sk_test_..., pk_test_...) until launch
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Platform fee taken from each released milestone, in basis points (1500 = 15%)
PLATFORM_FEE_BPS="1500"

# Secret for the hourly auto-approve job (GET /api/cron/auto-approve with "Authorization: Bearer <secret>")
CRON_SECRET=""

# Email alerts via Resend (https://resend.com). Leave empty to skip emails.
RESEND_API_KEY=""
EMAIL_FROM="The True Scholars <notifications@thetruescholars.com>"

# Public URL of this app (used for Paystack callback URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# The main website the app belongs to (WordPress). Links in the header and footer point back to it.
NEXT_PUBLIC_SITE_URL="https://thetruescholars.com"

# Qualitative Studio
DEEPGRAM_API_KEY=""          # transcription (server-side only)
# Cloudflare R2 for recordings (optional; without it recordings are stored in the database)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
